DOCKER_IMAGE="code-agent:latest"
APP_HOST=localhost
APP_PORT=8003
LOG_LEVEL=INFO
LOG_SKIP_STATIC_ACCESS=true
API_DOCS_ENABLED=true
ADMIN_USERNAME=admin
# Clear COMPOSE_PROFILES and configure DB_HOST to use external storage.
COMPOSE_PROFILES=local-storage
DB_USER=code_agent
DB_NAME=code_agent
# secrets: do "make secrets" for values
# DB_PASSWORD=
# ADMIN_PASSWORD=
# VENDOR_ENCRYPTION_KEY=
# APP_SECRET_KEY=
# Selectel Billing balance integration. Use either a static token or service-account credentials.
SELECTEL_BALANCE_URL=https://api.selectel.ru/v3/balances
# Cache normalized balance in this application process for 1 hour (0 disables caching).
SELECTEL_BALANCE_CACHE_TTL_SECONDS=3600
# SELECTEL_BALANCE_TOKEN=
# SELECTEL_BALANCE_USERNAME=
# SELECTEL_BALANCE_ACCOUNT_ID=
# SELECTEL_BALANCE_PASSWORD=
